# ==============================================================================
# FOTOFLOW — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local no desenvolvimento ou configure no Lovable/Supabase
# ==============================================================================

# Modo de dados do frontend: 'mock' (sem rede, offline) ou 'supabase' (chamadas reais)
VITE_DATA_MODE=mock

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Chave anônima pública do Supabase para requisições frontend
VITE_SUPABASE_ANON_KEY=

# URL pública base do Web App em produção (ex: https://fotoflow.app)
VITE_APP_URL=

# ID do Meta Pixel para rastreamento no navegador (ex: 1234567890)
VITE_META_PIXEL_ID=

# ------------------------------------------------------------------------------
# VARIÁVEIS EXCLUSIVAS DO SERVIDOR / EDGE FUNCTIONS (NUNCA EXPONHA NO FRONTEND)
# ------------------------------------------------------------------------------

# Chave da API WaveSpeed AI (formato ws_...) para execução das predições de IA
WAVESPEED_API_KEY=

# Chave Service Role com privilégios de administração no banco Supabase
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta de autenticação do provedor de pagamentos PIX (ex: Asaas, Mercado Pago, Woovi)
PIX_PROVIDER_KEY=

# Segredo criptográfico para validação da assinatura de webhooks do PIX
PIX_WEBHOOK_SECRET=

# Token de acesso da Conversion API (CAPI) do Meta para envio server-side
META_CAPI_TOKEN=
